+
--- a/src/backend/vulkan/codegen/ir_builder.cc
+++ b/src/backend/vulkan/codegen/ir_builder.cc
@@ -40,3 +40,6 @@
-  // Target SPIR-V version 1.0.  Additional functionality will be
